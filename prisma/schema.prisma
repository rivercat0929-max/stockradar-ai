generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String      @id @default(cuid())
  email     String      @unique
  name      String
  createdAt DateTime    @default(now())
  watchlist Watchlist[]
  alerts    Alert[]
}

model Watchlist {
  id              String   @id @default(cuid())
  userId          String
  ticker          String
  companyName     String
  market          String
  status          String
  group           String   @default("重点观察")
  targetBuyPrice  Float?
  targetSellPrice Float?
  watchReason     String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id])

  @@unique([userId, ticker])
}

model Holding {
  id               String   @id @default(cuid())
  accountId        String
  account          PortfolioAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  ticker           String
  companyName      String?
  shares           Float
  averageCost      Float
  targetAllocation Float?
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model PortfolioAccount {
  id          String    @id @default(cuid())
  name        String
  broker      String?
  accountType String?
  currency    String    @default("USD")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  holdings    Holding[]
}

model StockScore {
  id               String   @id @default(cuid())
  ticker           String
  totalScore       Int
  fundamentalScore Int
  valuationScore   Int
  technicalScore   Int
  catalystScore    Int
  macroScore       Int
  riskScore        Int
  scoreDate        DateTime
}

model Alert {
  id        String   @id @default(cuid())
  userId    String
  ticker    String?
  alertType String
  priority  String
  title     String
  content   String
  status    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model UserSettings {
  id        String   @id @default(cuid())
  settings  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AlertRule {
  id            String       @id @default(cuid())
  symbol        String
  ruleType      String
  operator      String?
  threshold     Float?
  configuration Json         @default("{}")
  isEnabled     Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  events        AlertEvent[]
}

model AlertEvent {
  id                  String     @id @default(cuid())
  alertRuleId         String?
  alertRule           AlertRule? @relation(fields: [alertRuleId], references: [id], onDelete: SetNull)
  symbol              String
  eventType           String
  message             String
  marketPrice         Float?
  marketDataSource    String?
  marketDataUpdatedAt DateTime?
  isStale             Boolean    @default(false)
  triggeredAt         DateTime   @default(now())
  acknowledgedAt      DateTime?
  metadata            Json       @default("{}")
}

model DailyReport {
  id            String   @id @default(cuid())
  reportDate    DateTime @unique @db.Date
  reportContent Json
  summaryText   String?
  createdAt     DateTime @default(now())
}

model MarketDataCache {
  symbol         String   @id
  data           Json
  originalSource String?
  updatedAt      DateTime?
  cachedAt       DateTime @default(now())
  expiresAt      DateTime
}

model EventCache {
  cacheKey  String   @id
  data      Json
  sources   Json     @default("[]")
  cachedAt  DateTime @default(now())
  expiresAt DateTime
}

model BacktestResult {
  id              String   @id @default(cuid())
  ticker          String
  signalType      String
  sampleSize      Int
  winRate5d       Float
  winRate20d      Float
  winRate60d      Float
  avgReturn20d    Float
  maxDrawdown     Float
  profitLossRatio Float
  signalGrade     String
  createdAt       DateTime @default(now())
}
